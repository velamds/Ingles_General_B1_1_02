cted": 0}], "id": 13, "_data": [{"contents": [{"type": "rec", "content": ""}], "type": "question"}, {"type": "objective", "content": "secondary_1"}]}], "type": "SR1", "id": 11, "_data": [{"contents": [{"type": "text", "content": " Time to practice the consonant blend pr."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Activity 1"}], "type": "group"}, {"type": "feedback", "content": {"attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "correct_feedback": "You are done!", "allowed_attempts": 2, "incorrect_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}]}}, {"contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}, {"contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">\nListen to the audio. </span> <span class=\"bullet\">\nRecord yourself saying the sentences aloud.</span>\n <span class=\"bullet\">\nCompare yourself to the audio.</span>"}], "type": "post_instructions"}]}], "type": "scholar", "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le02ob04re2img01.jpg", "audiosrc": "engenn6le02ob04re2aud01", "images": [{"time": "0", "image": "engenn6le02ob04re2img01.jpg", "id": 0, "text": ""}, {"time": "100", "image": "engenn6le02ob04re2img01.jpg", "id": 1, "text": "Marie Curie (1867-1934) was a famous physicist and chemist who conducted research on radioactivity.  She was the first woman to win a Nobel Prize and the only person to win it twice.  In addition, she was also the first woman to become a professor at the University of Paris."}, {"time": "21000", "image": "engenn6le02ob04re2img04.jpg", "id": 2, "text": "Due to her incredible contribution to the scientific community, she was entombed in the Panth\u00e9on in Paris in 1996 on her own merits.  She was an honest person and lived a moderate lifestyle.  She did not live a life of privilege but lived a practical life. In fact, she gave much of her first Nobel Prize money to friends, family, students, and research associates."}, {"time": "47500", "image": "engenn6le02ob04re2img03.jpg", "id": 3, "text": "Often, she and her husband refused to accept medals or awards. They believed that their work was more important than fame. Marie Curie has become an icon in the scientific world. To attain her scientific achievements, she had to overcome the barriers that were placed in her way because she was a woman."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}, {"contents": [{"type": "audio", "value": ""}], "template_override": 1, "title": "", "type": "text", "id": 2, "_data": []}, {"contents": [{"type": "audio", "value": ""}], "template_override": 1, "title": "", "type": "text", "id": 3, "_data": []}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Famous People"}, {"type": "unit_name", "content": "Changing History"}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 2}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Accurately use information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations."}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le02ob04re1img01.png"}, {"contents": [{"type": "heading", "content": "The R Sound with Other Consonants"}, {"type": "describer", "content": "Consonant blends are a collection of two or three different consonant sounds that are each heard when the word is pronounced.   </p>For example, in the word price, you can hear both the letters p and r. It makes a consonant blend."}, {"type": "text", "content": "Here are some examples of consonant blends with the pr sound:  </p>Examples: <span class=\"italic\">prick</span>, <span class=\"italic\">prize</span>, <span class=\"italic\">prey</span>, <span class=\"italic\">pretzel</span>, <span class=\"italic\">prairie</span>, <span class=\"italic\">prove</span>, <span class=\"italic\">press</span>, <span class=\"italic\">price</span>, <span class=\"italic\">pride</span>"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Stressing New Information"}, {"type": "describer", "content": "Sentence stress gives English its <span class=\"strong\">rhythm</span> or \"beat\".</p>    Word stress is emphasis on <span class=\"strong\">one syllable</span> within a <span class=\"strong\">word</span>.</p>  Sentence stress is emphasis on <span class=\"strong\">certain words</span> within a <span class=\"strong\">sentence</span>.</p>  Most sentences have two basic types of words:</p> <span class=\"strong\">Content words</span> <ul><li>Content words are the keywords of a sentence. They provide the most important information of the sentence.</li></ul> <span class=\"strong\">Structure words</span></br> <ul><li>Structure words are not the key words. They are words that you use to connect key words in a sentence.</li></ul> <span class=\"strong\">New Information Stress</span></br> When asked a question, the requested information is stressed.</p> For example: </br>Where are you from? - I come from <span class=\"strong\">Cambridge</span>, in the USA. </br>What do you want to do? - I want to go to the <span class=\"strong\">movies</span></br> When does the movie begin? - The class begins at <span class=\"strong\">eight o'clock</span>."}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "to conduct"}, {"type": "definition", "content": "to plan and do something, such as an activity"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Marie Curie conducted research into radioactivity."}, {"type": "audio", "content": "engenn6le02ob04aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": "These are words you use in a paragraph about a person in history."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "radioactivity"}, {"type": "definition", "content": "having or producing a powerful and dangerous form of energy "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Scientists study radioactivity."}, {"type": "audio", "content": "engenn6le02ob04aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "contribution"}, {"type": "definition", "content": "something that is done to cause something to happen"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She made a large contribution to the field of science."}, {"type": "audio", "content": "engenn6le02ob04aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "fame"}, {"type": "definition", "content": "the condition of being known or recognized by many people"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She was not interested in fame."}, {"type": "audio", "content": "engenn6le02ob04aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "moderate"}, {"type": "definition", "content": "not too expensive, not cheap"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: She lived a moderate lifestyle."}, {"type": "audio", "content": "engenn6le02ob04aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "associate"}, {"type": "definition", "content": "a member of a group or organization who is at a level that is below the highest level"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She gave money to her associates."}, {"type": "audio", "content": "engenn6le02ob04aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to entomb"}, {"type": "definition", "content": "to place (someone or something) in a tomb "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Marie Curie is entombed in Paris."}, {"type": "audio", "content": "engenn6le02ob04aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "privilege"}, {"type": "definition", "content": "a right or benefit that is given to some people and not to others"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She did not life a life of privilege."}, {"type": "audio", "content": "engenn6le02ob04aud08"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "icon"}, {"type": "definition", "content": "a person who is very successful and admired"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Marie Curie is an icon."}, {"type": "audio", "content": "engenn6le02ob04aud09"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to overcome"}, {"type": "definition", "content": "to successfully deal with something"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: She had to overcome a lot of barriers."}, {"type": "audio", "content": "engenn6le02ob04aud10"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "barrier"}, {"type": "definition", "content": "a law, rule, or problem that makes something difficult"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: She had to overcome a lot of barriers."}, {"type": "audio", "content": "engenn6le02ob04aud11"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Research another famous female scientist who won a Nobel Prize."}, {"type": "text", "content": "Write an 80-100 word paragraph about her life."}, {"type": "text", "content": "Include why you admire this scientist."}, {"type": "text", "content": "Include at least 4 words with the consonant blend pr."}, {"type": "text", "content": "Read your paragraph aloud to a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I research a famous female scientist."}, {"type": "text", "content": "I write a paragraph about a scientist I admire."}, {"type": "text", "content": "I use words with consonant blends like the word prize."}, {"type": "text", "content": "I read the paragraph about a scientist to a partner."}]}]}